# Copy to /opt/monitoring/.env and fill in real values.
# Keep it out of version control and restrict access:  chmod 600 .env
# --- Grafana ---
# Admin password for the built-in user (required).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# --- Proxmox exporter (all three required) ---
# API user, including realm, e.g. monitoring@pve or monitoring@pam
PVE_USER=monitoring@pve
# Name of the API token created under that user in Proxmox
PVE_TOKEN_NAME=prometheus
# Secret value shown once when the token was created
PVE_TOKEN_VALUE=replace-me

# --- Optional ---
# Pin the pve-exporter image to a specific version tag (defaults to "latest" if unset).
# PVE_EXPORTER_TAG=3.5.2
